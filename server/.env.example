# Polyglot AI — Backend Server: local environment template.
#
# Copy this file to .env (which is gitignored) and uncomment / edit the lines
# you want to override. Every variable here has a default in
# src/main/resources/application.yml, so an empty .env is a valid configuration —
# this file documents what *can* be set, not what must be.
#
# The Spring Boot Gradle plugin does NOT auto-load .env. To use these values, either:
#   1. Export them in your shell:   set -a; source server/.env; set +a; ./gradlew bootRun
#   2. Use a dotenv tool of your choice (direnv, dotenv-cli, etc.)
#
# Never commit real credentials to .env.example.

# ─── Database (Postgres + pgvector) ──────────────────────────────────────────
# Default JDBC URL matches the docker-compose service. Note port 5433, chosen to
# avoid colliding with a locally-installed Postgres on the default 5432.
# POLYGLOT_DB_URL=jdbc:postgresql://localhost:5433/polyglot
# POLYGLOT_DB_USER=polyglot
# POLYGLOT_DB_PASSWORD=polyglot

# ─── Database (MongoDB) ──────────────────────────────────────────────────────
# POLYGLOT_MONGO_URI=mongodb://localhost:27017/polyglot

# ─── HTTP server ─────────────────────────────────────────────────────────────
# POLYGLOT_PORT=8080

# ─── GraphQL ─────────────────────────────────────────────────────────────────
# Enables the GraphiQL UI at /graphiql. Default: true (open in local dev,
# protected by the security filter in deployed environments).
# POLYGLOT_GRAPHIQL_ENABLED=true

# ─── Security ────────────────────────────────────────────────────────────────
# OAuth2 resource-server issuer. When set, /graphql requires a JWT validated
# against this issuer. Leave blank to disable JWT validation.
# POLYGLOT_JWT_ISSUER_URI=

# !! INSECURE DEV MODE !!
# When true, opens /graphql and /graphiql to unauthenticated requests so you
# can iterate locally without setting up an IdP. The application logs a loud
# WARN at startup whenever this is on.
#
# THIS MUST BE false (the default) IN ANY DEPLOYED ENVIRONMENT.
# POLYGLOT_SECURITY_INSECURE_DEV=true

# ─── Logging ─────────────────────────────────────────────────────────────────
# Log level for the application's own packages. Default: INFO.
# LOGGING_LEVEL_COM_POLYGLOTAI=DEBUG

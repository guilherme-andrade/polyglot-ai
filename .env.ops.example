# Ops credentials — used by CI/CD tooling and the review skill.
# Copy this file to .env.ops and fill in real values.
# .env.ops is gitignored — never commit real credentials.

# GitHub token for the reviewer bot account.
# Create at: https://github.com/settings/tokens
# Scopes needed: repo (private repos) or public_repo (public repos)
# The bot account is used solely for posting PR reviews so review
# activity is clearly separated from personal accounts.
REVIEWER_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
